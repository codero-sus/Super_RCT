# Optional. Copy to python.env and set the Python 3 interpreter to use.
# If this file is missing or PYTHON is empty, the environment variable 2PY2 is used,
# then python3 / python on PATH. The updater scripts use the same order.
# Examples:
#   PYTHON=/usr/bin/python3
#   PYTHON=/opt/python-portable/bin/python3
#   PYTHON=C:\Program Files\Python312\python.exe
#   PYTHON=D:\PortablePython\python.exe
PYTHON=
